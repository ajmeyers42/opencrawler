# Sample environment values for the multi-locale Open Crawler artifact.
# Copy to .env and replace placeholders. Never commit .env.

# Target site
CRAWLER_DOMAIN=https://support.example.com
CRAWLER_SEED_US=https://support.example.com/us/en
CRAWLER_SEED_UK=https://support.example.com/uk/en
CRAWLER_SEED_MX=https://support.example.com/mx/en

# Output/index settings
CRAWLER_OUTPUT_INDEX_US=search-crawler-support-us
CRAWLER_PIPELINE_US=search-crawler-support@custom
CRAWLER_OUTPUT_INDEX_UK=search-crawler-support-uk
CRAWLER_PIPELINE_UK=search-crawler-support@custom
CRAWLER_OUTPUT_INDEX_MX=search-crawler-support-mx
CRAWLER_PIPELINE_MX=search-crawler-support@custom
CRAWLER_MAX_DEPTH=10

# Elasticsearch credentials
ELASTICSEARCH_HOST=https://es.example.com:443
ELASTICSEARCH_API_KEY=

# Optional file-sink validation run
CRAWLER_OUTPUT_DIR=./results/multi-locale
